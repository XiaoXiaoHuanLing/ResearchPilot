# ResearchPilot Backend Configuration
# Copy this file to .env and fill in your values

# ─── Alibaba DashScope (Unified for Chat + Embedding) ───
# All LLM and embedding calls go through DashScope's OpenAI-compatible API
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Chat model: qwen3.5 series
# Options: qwen3.5-35b-a3b | qwen3.5-flash-2026-02-23 | qwen3.5-27b
#          qwen3.5-122b-a10b | qwen3.5-plus-2026-02-15 | qwen3.5-397b-a17b
# - qwen3.5-plus:    旗舰商业版，1M上下文，效果最强，输入2元/M输出12元/M
# - qwen3.5-397b:    开源MoE旗舰，激活17B，效果接近Plus，免费额度
# - qwen3.5-122b:    开源MoE中型，激活10B，均衡性能与资源
# - qwen3.5-35b:     开源MoE小型，激活3B，速度快，适合工具调用
# - qwen3.5-27b:     开源Dense中型，全参数激活
# - qwen3.5-flash:   商业轻量版，1M上下文，输入0.2元/M输出2元/M，最快最便宜
DASHSCOPE_MODEL_NAME=qwen3.5-35b-a3b

# Optional fallback model (same API, auto-switch on failure)
DASHSCOPE_MODEL_NAME_FALLBACK=

# Embedding model
DASHSCOPE_MODEL_EMBEDDING_NAME=text-embedding-v3
# DASHSCOPE_MODEL_EMBEDDING_NAME_FALLBACK=text-embedding-v4

# ─── Web Search API (at least one required) ───
# Tavily (recommended): https://tavily.com
TAVILY_API_KEY=
# Serper (alternative): https://serper.dev
SERPER_API_KEY=

# ─── ChromaDB (default: ./chroma_db) ───
# RESEARCHPILOT_CHROMA_PERSIST_DIR=./chroma_db
