# ResearchPilot Backend Configuration
# Copy this file to .env and fill in your values

# Application
RESEARCHPILOT_APP_NAME=ResearchPilot API

# ─── Chat LLM (OpenAI-compatible API) ───
# Used for ALL chat/generation tasks: Copilot, QA, Report, HyDE, Supervisor
OPENAI_BASE_URL=https://your-openai-compatible-api/v1
OPENAI_API_KEY=your-api-key
OPENAI_MODEL_NAME=glm-5.1

# Optional: fallback model when primary fails (same API endpoint, different model)
# OPENAI_MODEL_NAME_FALLBACK=

# ─── Embedding Model (Alibaba DashScope) ───
# Separate from chat LLM — Alibaba embedding models via DashScope
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_API_KEY=your-alibaba-api-key
ALIBABA_MODEL_EMBEDDING_NAME=text-embedding-v3
# Optional fallback embedding model
# ALIBABA_MODEL_EMBEDDING_NAME_FALLBACK=text-embedding-v4

# ─── Web Search API (at least one required) ───
# Tavily (recommended): https://tavily.com
TAVILY_API_KEY=
# Serper (alternative): https://serper.dev
SERPER_API_KEY=

# ─── ChromaDB (default: ./chroma_db) ───
# RESEARCHPILOT_CHROMA_PERSIST_DIR=./chroma_db
