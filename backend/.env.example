# ResearchPilot Backend Configuration
# Copy this file to .env and fill in your values

# Application
RESEARCHPILOT_APP_NAME=ResearchPilot API

# Database (default: SQLite in project root)
# RESEARCHPILOT_DATABASE_URL=sqlite:///./researchpilot.db
# For PostgreSQL: postgresql://user:pass@localhost:5432/researchpilot

# OpenAI API (required for RAG + LLM-powered report generation)
RESEARCHPILOT_OPENAI_API_KEY=
RESEARCHPILOT_OPENAI_BASE_URL=
# RESEARCHPILOT_EMBEDDING_MODEL=text-embedding-3-small
# RESEARCHPILOT_LLM_MODEL=gpt-4o-mini

# ChromaDB persist directory (default: ./chroma_db)
# RESEARCHPILOT_CHROMA_PERSIST_DIR=./chroma_db

# Web Search API (at least one required for real article collection)
# Tavily (recommended): https://tavily.com
RESEARCHPILOT_TAVILY_API_KEY=
# Serper (alternative): https://serper.dev
RESEARCHPILOT_SERPER_API_KEY=

